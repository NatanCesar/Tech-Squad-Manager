# String de conexão do PostgreSQL usada pelo Prisma.
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tech_squad_manager"

# Origem do frontend autorizada no CORS e no Socket.io (use * para permitir qualquer IP na rede local).
FRONTEND_ORIGIN=*

# Porta do servidor backend (opcional; padrão 3001).
# PORT=3001
